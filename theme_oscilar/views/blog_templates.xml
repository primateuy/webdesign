<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
        ====================================================================
        LISTADO DEL BLOG — Encabezado editorial
        ====================================================================
        TEMPORALMENTE COMENTADO: el template ID website_blog.latest_blogs
        no existe en esta instalación de Odoo 18.

        Para encontrar el ID correcto, ejecutar en el shell de Odoo:
            templates = env['ir.ui.view'].search_read(
                [('type', '=', 'qweb'), ('key', 'like', 'website_blog')],
                ['key', 'name'], order='key asc'
            )
            for t in templates: print(t['key'])

        Una vez confirmado el ID correcto, descomentar y actualizar
        el inherit_id con el valor real.
        ====================================================================

        <template
            id="oscilar_blog_listing_header"
            inherit_id="website_blog.latest_blogs"
            name="Oscilar - Encabezado Listado Blog"
        >
            <xpath expr="//div[@id='wrap']" position="prepend">
                <div class="oscilar-blog-hero">
                    <div class="container">
                        <p class="oscilar-kicker">Oscilar para Existir</p>
                        <h1 class="oscilar-blog-title">
                            El Mundo Después del Mapa
                        </h1>
                        <div class="oscilar-accent-bar"></div>
                        <p class="oscilar-blog-subtitle">
                            Reflexiones sobre la vida, el trabajo y la incertidumbre.
                        </p>
                    </div>
                </div>
            </xpath>
        </template>
        -->


        <!--
        ====================================================================
        POST INDIVIDUAL — Encabezado editorial
        ====================================================================
        inherit_id: website_blog.blog_post_complete
        NOTA: si este ID tampoco existe en v18, comentar de la misma forma
        y reportar el error para corregir.
        ====================================================================
        -->
        <template
            id="oscilar_blog_post_hero"
            inherit_id="website_blog.blog_post_complete"
            name="Oscilar - Header Editorial Post"
        >
            <xpath expr="//div[@id='wrap']" position="prepend">
                <div class="oscilar-post-hero">
                    <div class="container">

                        <p class="oscilar-kicker">
                            <t t-if="blog_post.tag_ids">
                                <t t-foreach="blog_post.tag_ids" t-as="tag">
                                    <t t-esc="tag.name"/>
                                    <t t-if="not tag_last"> · </t>
                                </t>
                            </t>
                            <t t-else="">Reflexión</t>
                        </p>

                        <h1 class="oscilar-post-title">
                            <t t-esc="blog_post.name"/>
                        </h1>

                        <t t-if="blog_post.subtitle">
                            <p class="oscilar-post-subtitle">
                                <t t-esc="blog_post.subtitle"/>
                            </p>
                        </t>

                        <div class="oscilar-accent-bar"></div>

                        <p class="oscilar-post-meta">
                            <t t-esc="blog_post.author_id.name"/>
                            <t t-if="blog_post.post_date">
                                <span> · </span>
                                <span
                                    t-field="blog_post.post_date"
                                    t-options='{"widget": "date"}'
                                />
                            </t>
                        </p>

                    </div>
                </div>
            </xpath>
        </template>

    </data>
</odoo>
