<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         PÁGINA NUEVA: design-pipa
         Se crea automáticamente al instalar el módulo.
         No toca ninguna página existente del sitio.
    ====================================================================== -->
    <record id="dp_landing_view" model="ir.ui.view">
        <field name="name">design_pipa.landing</field>
        <field name="type">qweb</field>
        <field name="key">design_pipa_theme.dp_landing_view</field>
        <field name="arch" type="xml">
            <t t-name="design_pipa_theme.dp_landing_view">
                <t t-call="website.layout">
                    <div id="wrap">
                        <div class="dp-page">

                        <!-- NAV INTERNA FIJA -->
                        <nav class="dp-subnav">
                            <div class="dp-subnav__inner">
                                <a href="#inicio">Sobre o Estúdio</a>
                                <a href="#produtos-servicos">Produtos e Serviços</a>
                                <a href="#assessoria">Assessoria</a>
                            </div>
                        </nav>

                        <!-- ANCLA: INICIO -->
                        <div id="inicio">

                            <!-- HERO -->
                            <section class="dp-hero">
                                <div class="container">
                                    <div class="row align-items-center">
                                        <div class="col-lg-7">
                                            <p class="dp-hero__eyebrow">
                                                À mais de 12 anos com base no Paraíso da Praia da Pipa, RN — Brasil
                                            </p>
                                            <h1 class="dp-hero__title">
                                                Comunicação<br/>
                                                Design<br/>
                                                Produção Gráfica
                                            </h1>
                                            <a href="#produtos-servicos" class="dp-hero__cta">
                                                Clique e conheça o que podemos fazer por você
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <!-- POR QUÉ DESIGN PIPA -->
                            <section class="dp-why">
                                <div class="container">
                                    <div class="row align-items-center">
                                        <div class="col-lg-6 dp-why__col-text">
                                            <p class="dp-why__label">Por qué Design Pipa</p>
                                            <h2 class="dp-why__title">
                                                Aqui ou desde qualquer<br/>lugar do mundo?
                                            </h2>
                                            <p class="dp-why__body">
                                                Somos a única agência nesta região paradisíaca do litoral nordestino.
                                                Morar e construir aqui, seja uma vida ou projetos criativos tem as suas
                                                particularidades. E o que melhor, que pessoas que conhecem a dinâmica,
                                                estilo de vida, rotatividade, tendências, público e mais... para
                                                acompanhar a jornada da sua marca?
                                            </p>
                                            <a href="#produtos-servicos" class="dp-why__cta">Quero saber mais!</a>
                                        </div>
                                        <div class="col-lg-6">
                                            <div class="dp-why__image-wrap">
                                                <!-- PLACEHOLDER: reemplazar por foto de Agus desde el editor visual -->
                                                <img src="/design_pipa_theme/static/src/img/placeholder_portrait.jpg"
                                                     alt="Agus Correa — CEO e Designer"/>
                                                <div class="dp-why__script">
                                                    nesta casa delirios criativos,<br/>
                                                    sonhos que viram projetos<br/>
                                                    e a coragem de comunicar,<br/>
                                                    são acolhidos
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <!-- DESTAQUE INTERNACIONAL -->
                            <section class="dp-highlight">
                                <div class="container">
                                    <div class="row justify-content-center">
                                        <div class="col-lg-8 text-center">
                                            <h2 class="dp-highlight__title">
                                                Se você não está no Brasil,
                                            </h2>
                                            <p class="dp-highlight__body">
                                                Contratar uma equipe com olhar completamente cosmopolita
                                                e inspirado no mundo mas com o tempero de Brasil.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </section>

                        </div><!-- //#inicio -->

                        <!-- ANCLA: PRODUTOS E SERVIÇOS -->
                        <div id="produtos-servicos">

                            <!-- SERVICIOS -->
                            <section class="dp-services">
                                <div class="container">
                                    <div class="dp-services__header">
                                        <p class="dp-services__label">sua assistência criativa começa aqui</p>
                                        <h2 class="dp-services__title">Conheça nosso catálogo</h2>
                                        <p class="dp-services__subtitle">de produtos &amp; serviços</p>
                                    </div>
                                    <div class="row align-items-start">
                                        <div class="col-lg-6">
                                            <ul class="dp-services__list">
                                                <li>identidade visual</li>
                                                <li>logotipos</li>
                                                <li>branding</li>
                                                <li>re-branding</li>
                                                <li>comunicação</li>
                                                <li>artes digitais</li>
                                                <li>marketing</li>
                                                <li>cobertura de eventos</li>
                                                <li>instalação de adesivos</li>
                                            </ul>
                                        </div>
                                        <div class="col-lg-6">
                                            <!-- PLACEHOLDER: reemplazar por foto de servicios desde el editor visual -->
                                            <img src="/design_pipa_theme/static/src/img/placeholder_services.jpg"
                                                 alt="Servicios Design Pipa"
                                                 class="dp-services__image"/>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <!-- PORTFOLIO GRID -->
                            <section class="dp-portfolio">
                                <div class="container-fluid">
                                    <div class="dp-portfolio__grid">
                                        <!-- PLACEHOLDER x8: reemplazar cada imagen desde el editor visual -->
                                        <div class="dp-portfolio__item">
                                            <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg" alt="Portafolio 1"/>
                                        </div>
                                        <div class="dp-portfolio__item">
                                            <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg" alt="Portafolio 2"/>
                                        </div>
                                        <div class="dp-portfolio__item">
                                            <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg" alt="Portafolio 3"/>
                                        </div>
                                        <div class="dp-portfolio__item">
                                            <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg" alt="Portafolio 4"/>
                                        </div>
                                        <div class="dp-portfolio__item">
                                            <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg" alt="Portafolio 5"/>
                                        </div>
                                        <div class="dp-portfolio__item">
                                            <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg" alt="Portafolio 6"/>
                                        </div>
                                        <div class="dp-portfolio__item">
                                            <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg" alt="Portafolio 7"/>
                                        </div>
                                        <div class="dp-portfolio__item">
                                            <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg" alt="Portafolio 8"/>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <!-- PRODUCCIÓN GRÁFICA -->
                            <section class="dp-print">
                                <div class="container">
                                    <div class="row align-items-center">
                                        <div class="col-lg-5">
                                            <h2 class="dp-print__title">
                                                <span>produção</span>
                                                GRÁFICA
                                            </h2>
                                            <p class="dp-print__sub">envios para todo Brasil.</p>
                                            <a href="#assessoria" class="dp-print__cta">Solicite aqui seu orçamento</a>
                                            <p class="dp-print__script">todo tipo de impressão!</p>
                                        </div>
                                        <div class="col-lg-7">
                                            <ul class="dp-print__list">
                                                <li>impressões A5, A4, A3</li>
                                                <li>letreiros</li>
                                                <li>flyer</li>
                                                <li>folder</li>
                                                <li>cartão de visita</li>
                                                <li>cardápio</li>
                                                <li>adesivos</li>
                                                <li>tag</li>
                                                <li>fardamentos</li>
                                                <li>bonés</li>
                                                <li>eco bags</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </section>

                        </div><!-- //#produtos-servicos -->

                        <!-- ANCLA: ASSESSORIA -->
                        <div id="assessoria">

                            <!-- BRAND MANAGER -->
                            <section class="dp-brand-manager"
                                     style="background-image: url('/design_pipa_theme/static/src/img/placeholder_bg.jpg')">
                                <div class="container">
                                    <div class="row justify-content-center">
                                        <div class="col-lg-8 text-center">
                                            <p class="dp-brand-manager__eyebrow">Que comunica sua marca?</p>
                                            <h2 class="dp-brand-manager__title">Brand Manager</h2>
                                            <p class="dp-brand-manager__subtitle">
                                                Assessoria de Comunicação<br/>
                                                Vamos construir juntos a estratégia definitiva.
                                            </p>
                                            <a href="mailto:contato@designpipa.com.br" class="dp-brand-manager__cta">
                                                Quero saber mais
                                            </a>
                                            <p class="dp-brand-manager__script">algo com esta letra.</p>
                                        </div>
                                    </div>
                                </div>
                            </section>

                        </div><!-- //#assessoria -->

                    </div><!-- //.dp-page -->
                    </div><!-- //#wrap -->
                </t>
            </t>
        </field>
    </record>


    <!-- =====================================================================
         PÁGINA: se declara DESPUÉS de la vista para que ref= pueda resolverla
    ====================================================================== -->
    <record id="dp_landing_page" model="website.page">
        <field name="name">Design Pipa</field>
        <field name="url">/design-pipa</field>
        <field name="is_published">True</field>
        <field name="view_id" ref="dp_landing_view"/>
    </record>

</odoo>
