<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         CATEGORÍA DE SNIPPETS EN EL BUILDER — v19
         En Odoo 19 el panel usa <snippets id="snippet_groups"> para registrar
         el grupo y <snippets id="snippet_structure"> para los snippets,
         con atributo group="design_pipa" para asociarlos.
         Ref: https://www.odoo.com/documentation/19.0/developer/howtos/website_themes/building_blocks.html
    ====================================================================== -->
    <template id="snippets" inherit_id="website.snippets" name="Design Pipa — Snippets">

        <!-- 1. Registrar el grupo "Design Pipa" en el panel lateral -->
        <xpath expr="//snippets[@id='snippet_groups']/*[1]" position="before">
            <t snippet-group="design_pipa"
               t-snippet="website.s_snippet_group"
               string="Design Pipa"
               t-thumbnail="/design_pipa_theme/static/src/img/thumb_hero.png"/>
        </xpath>

        <!-- 2. Registrar cada snippet asociado al grupo -->
        <xpath expr="//snippets[@id='snippet_structure']/*[1]" position="before">
            <t t-snippet="design_pipa_theme.dp_snippet_hero"
               string="DP — Hero"
               group="design_pipa"
               t-thumbnail="/design_pipa_theme/static/src/img/thumb_hero.png">
                <keywords>Hero portada</keywords>
            </t>
            <t t-snippet="design_pipa_theme.dp_snippet_why"
               string="DP — Por qué Design Pipa"
               group="design_pipa"
               t-thumbnail="/design_pipa_theme/static/src/img/thumb_why.png">
                <keywords>Por qué about</keywords>
            </t>
            <t t-snippet="design_pipa_theme.dp_snippet_highlight"
               string="DP — Destaque Internacional"
               group="design_pipa"
               t-thumbnail="/design_pipa_theme/static/src/img/thumb_highlight.png">
                <keywords>Destaque internacional</keywords>
            </t>
            <t t-snippet="design_pipa_theme.dp_snippet_services"
               string="DP — Servicios"
               group="design_pipa"
               t-thumbnail="/design_pipa_theme/static/src/img/thumb_services.png">
                <keywords>Servicios catálogo</keywords>
            </t>
            <t t-snippet="design_pipa_theme.dp_snippet_portfolio"
               string="DP — Portafolio Grid"
               group="design_pipa"
               t-thumbnail="/design_pipa_theme/static/src/img/thumb_portfolio.png">
                <keywords>Portafolio galería grid</keywords>
            </t>
            <t t-snippet="design_pipa_theme.dp_snippet_print"
               string="DP — Producción Gráfica"
               group="design_pipa"
               t-thumbnail="/design_pipa_theme/static/src/img/thumb_print.png">
                <keywords>Producción gráfica impresión</keywords>
            </t>
            <t t-snippet="design_pipa_theme.dp_snippet_brand_manager"
               string="DP — Brand Manager"
               group="design_pipa"
               t-thumbnail="/design_pipa_theme/static/src/img/thumb_brand_manager.png">
                <keywords>Brand manager CTA</keywords>
            </t>
        </xpath>

    </template>

    <!-- =====================================================================
         SNIPPET 1: HERO
         Sección principal de la landing. Fondo negro, título grande, CTA.
         Imagen placeholder: reemplazar "foto_hero.jpg" desde el editor.
    ====================================================================== -->
    <template id="dp_snippet_hero" name="DP — Hero">
        <section class="dp-hero">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-7">
                        <p class="dp-hero__eyebrow">
                            À mais de 12 anos com base no Paraíso da Praia da Pipa, RN — Brasil
                        </p>
                        <h1 class="dp-hero__title">
                            Comunicação<br/>
                            Design<br/>
                            Produção Gráfica
                        </h1>
                        <a href="#" class="dp-hero__cta">
                            Clique e conheça o que podemos fazer por você
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- =====================================================================
         SNIPPET 2: POR QUÉ DESIGN PIPA
         Texto + foto con cita manuscrita superpuesta.
         Imagen placeholder: reemplazar "foto_agus.jpg" desde el editor.
    ====================================================================== -->
    <template id="dp_snippet_why" name="DP — Por qué Design Pipa">
        <section class="dp-why">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 dp-why__col-text">
                        <p class="dp-why__label">Por qué Design Pipa</p>
                        <h2 class="dp-why__title">
                            Aqui ou desde qualquer<br/>lugar do mundo?
                        </h2>
                        <p class="dp-why__body">
                            Somos a única agência nesta região paradisíaca do litoral nordestino.
                            Morar e construir aqui, seja uma vida ou projetos criativos tem as suas
                            particularidades. E o que melhor, que pessoas que conhecem a dinâmica,
                            estilo de vida, rotatividade, tendências, público e mais... para
                            acompanhar a jornada da sua marca?
                        </p>
                        <a href="#" class="dp-why__cta">Quero saber mais!</a>
                    </div>
                    <div class="col-lg-6">
                        <div class="dp-why__image-wrap">
                            <!-- PLACEHOLDER: reemplazar por foto de Agus desde el editor visual -->
                            <img src="/design_pipa_theme/static/src/img/placeholder_portrait.jpg"
                                 alt="Agus Correa — CEO e Designer"
                                 class="o_editable_media"/>
                            <div class="dp-why__script">
                                nesta casa delirios criativos,<br/>
                                sonhos que viram projetos<br/>
                                e a coragem de comunicar,<br/>
                                são acolhidos
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- =====================================================================
         SNIPPET 3: DESTAQUE — "Se você não está no Brasil"
         Bloque de fondo negro con texto en blanco. Sin imagen.
    ====================================================================== -->
    <template id="dp_snippet_highlight" name="DP — Destaque Internacional">
        <section class="dp-highlight">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-8 text-center">
                        <h2 class="dp-highlight__title">
                            Se você não está no Brasil,
                        </h2>
                        <p class="dp-highlight__body">
                            Contratar uma equipe com olhar completamente cosmopolita
                            e inspirado no mundo mas com o tempero de Brasil.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- =====================================================================
         SNIPPET 4: SERVICIOS
         Lista de servicios a la izquierda + foto a la derecha.
         Imagen placeholder: reemplazar "foto_servicios.jpg" desde el editor.
    ====================================================================== -->
    <template id="dp_snippet_services" name="DP — Servicios">
        <section class="dp-services">
            <div class="container">
                <div class="dp-services__header">
                    <p class="dp-services__label">sua assistência criativa começa aqui</p>
                    <h2 class="dp-services__title">Conheça nosso catálogo</h2>
                    <p class="dp-services__subtitle">de produtos &amp; serviços</p>
                </div>
                <div class="row align-items-start">
                    <div class="col-lg-6">
                        <ul class="dp-services__list">
                            <li>identidade visual</li>
                            <li>logotipos</li>
                            <li>branding</li>
                            <li>re-branding</li>
                            <li>comunicação</li>
                            <li>artes digitais</li>
                            <li>marketing</li>
                            <li>cobertura de eventos</li>
                            <li>instalação de adesivos</li>
                        </ul>
                    </div>
                    <div class="col-lg-6">
                        <!-- PLACEHOLDER: reemplazar por foto de servicios desde el editor visual -->
                        <img src="/design_pipa_theme/static/src/img/placeholder_services.jpg"
                             alt="Servicios Design Pipa"
                             class="dp-services__image o_editable_media"/>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- =====================================================================
         SNIPPET 5: GRID DE PORTAFOLIO
         8 imágenes en grid 4x2. Todas son placeholders a reemplazar.
         Imagen placeholder: reemplazar cada item desde el editor visual.
    ====================================================================== -->
    <template id="dp_snippet_portfolio" name="DP — Portafolio Grid">
        <section class="dp-portfolio">
            <div class="container-fluid">
                <div class="dp-portfolio__grid">
                    <!-- PLACEHOLDER x8: reemplazar cada imagen desde el editor visual -->
                    <div class="dp-portfolio__item">
                        <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg"
                             alt="Portafolio 1" class="o_editable_media"/>
                    </div>
                    <div class="dp-portfolio__item">
                        <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg"
                             alt="Portafolio 2" class="o_editable_media"/>
                    </div>
                    <div class="dp-portfolio__item">
                        <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg"
                             alt="Portafolio 3" class="o_editable_media"/>
                    </div>
                    <div class="dp-portfolio__item">
                        <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg"
                             alt="Portafolio 4" class="o_editable_media"/>
                    </div>
                    <div class="dp-portfolio__item">
                        <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg"
                             alt="Portafolio 5" class="o_editable_media"/>
                    </div>
                    <div class="dp-portfolio__item">
                        <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg"
                             alt="Portafolio 6" class="o_editable_media"/>
                    </div>
                    <div class="dp-portfolio__item">
                        <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg"
                             alt="Portafolio 7" class="o_editable_media"/>
                    </div>
                    <div class="dp-portfolio__item">
                        <img src="/design_pipa_theme/static/src/img/placeholder_grid.jpg"
                             alt="Portafolio 8" class="o_editable_media"/>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- =====================================================================
         SNIPPET 6: PRODUCCIÓN GRÁFICA
         Fondo negro. Título grande a la izquierda, lista de productos a la derecha.
    ====================================================================== -->
    <template id="dp_snippet_print" name="DP — Producción Gráfica">
        <section class="dp-print">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-5">
                        <h2 class="dp-print__title">
                            <span>produção</span>
                            GRÁFICA
                        </h2>
                        <p class="dp-print__sub">envios para todo Brasil.</p>
                        <a href="#" class="dp-print__cta">Solicite aqui seu orçamento</a>
                        <p class="dp-print__script">todo tipo de impressão!</p>
                    </div>
                    <div class="col-lg-7">
                        <ul class="dp-print__list">
                            <li>impressões A5, A4, A3</li>
                            <li>letreiros</li>
                            <li>flyer</li>
                            <li>folder</li>
                            <li>cartão de visita</li>
                            <li>cardápio</li>
                            <li>adesivos</li>
                            <li>tag</li>
                            <li>fardamentos</li>
                            <li>bonés</li>
                            <li>eco bags</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- =====================================================================
         SNIPPET 7: BRAND MANAGER (CTA FINAL)
         Fondo con imagen + overlay oscuro. Texto centrado + CTA.
         Imagen de fondo: reemplazar desde el editor visual (background image).
    ====================================================================== -->
    <template id="dp_snippet_brand_manager" name="DP — Brand Manager">
        <section class="dp-brand-manager"
                 style="background-image: url('/design_pipa_theme/static/src/img/placeholder_bg.jpg')">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <p class="dp-brand-manager__eyebrow">Que comunica sua marca?</p>
                        <h2 class="dp-brand-manager__title">Brand Manager</h2>
                        <p class="dp-brand-manager__subtitle">
                            Assessoria de Comunicação<br/>
                            Vamos construir juntos a estratégia definitiva.
                        </p>
                        <a href="#" class="dp-brand-manager__cta">Quero saber mais</a>
                        <p class="dp-brand-manager__script">algo com esta letra.</p>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
